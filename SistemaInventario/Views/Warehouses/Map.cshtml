@model SistemaInventario.Models.Entities.Warehouse?
@{
    ViewData["Title"] = "Mapa Interactivo de Bodega";
    var warehouses = ViewBag.Warehouses as List<SistemaInventario.Models.Entities.Warehouse> ?? new List<SistemaInventario.Models.Entities.Warehouse>();
    int selectedWarehouseId = ViewBag.SelectedWarehouseId ?? 0;
}

<header class="w-full bg-white/80 dark:bg-[#1a2632]/90 backdrop-blur-md sticky top-0 z-10 border-b border-[#dbe0e6] dark:border-gray-800 px-6 py-4">
    <div class="flex flex-wrap justify-between items-center gap-4 max-w-[1400px] mx-auto">
        <div class="flex flex-col gap-1 w-full md:w-auto">
            <div class="flex items-center gap-2">
                <a asp-action="Index" class="text-[#617589] dark:text-gray-400 hover:text-primary transition-colors flex items-center gap-1 text-sm font-medium">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Bodegas
                </a>
                <span class="text-gray-300 dark:text-gray-600">/</span>
                <h2 class="text-[#111418] dark:text-white text-2xl font-bold leading-tight flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[28px]">map</span>
                    Mapa Interactivo 2D
                </h2>
            </div>
            <p class="text-[#617589] dark:text-gray-400 text-sm font-normal">Visualización espacial de estantes, ubicaciones y localización de productos en tiempo real</p>
        </div>

        <div class="flex items-center gap-3 flex-wrap w-full md:w-auto justify-end">
            <!-- Selector de Bodega -->
            <div class="relative min-w-[200px]">
                <select id="warehouseSelect" onchange="changeWarehouse(this.value)" class="h-10 w-full appearance-none rounded-xl border border-[#dbe0e6] bg-[#f8f9fa] pl-4 pr-10 text-sm font-bold text-[#111418] focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-gray-800 dark:bg-gray-800 dark:text-white cursor-pointer">
                    @foreach (var w in warehouses)
                    {
                        <!option value="@w.Id" @(w.Id == selectedWarehouseId ? "selected" : "")>🏢 @w.Name</!option>
                    }
                </select>
                <span class="material-symbols-outlined text-[#617589] dark:text-gray-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-[20px]">unfold_more</span>
            </div>

            <!-- Buscador en tiempo real con resaltado -->
            <div class="relative flex-1 max-w-md min-w-[260px]">
                <span class="material-symbols-outlined text-[#617589] dark:text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 text-[20px]">search</span>
                <input type="text" id="mapSearchInput" onkeyup="filterMapProducts()" placeholder="Buscar producto, SKU o código de barra..." class="h-10 w-full rounded-xl border border-[#dbe0e6] bg-[#f8f9fa] pl-10 pr-10 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-gray-800 dark:bg-gray-800 dark:text-white" />
                <button type="button" id="clearSearchBtn" onclick="clearMapSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
        </div>
    </div>
</header>

<div class="px-6 py-6 pb-20 max-w-[1400px] mx-auto">
    <!-- Barra de Leyenda de Colores -->
    <div class="bg-white dark:bg-[#1a2632] border border-[#dbe0e6] dark:border-gray-800 rounded-2xl p-4 mb-6 flex flex-wrap justify-between items-center gap-4 shadow-sm">
        <div class="flex items-center gap-6 flex-wrap text-xs font-semibold">
            <span class="text-gray-400 dark:text-gray-500 uppercase tracking-wider font-bold">Estado de Filas:</span>
            <div class="flex items-center gap-2">
                <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 shadow-sm"></span>
                <span class="text-[#111418] dark:text-gray-300">Con Productos</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3.5 h-3.5 rounded-full bg-gray-200 dark:bg-gray-700 border border-gray-300 dark:border-gray-600"></span>
                <span class="text-[#617589] dark:text-gray-400">Vacía / Disponible</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3.5 h-3.5 rounded-full bg-amber-400 animate-pulse shadow-sm"></span>
                <span class="text-[#111418] dark:text-gray-300 font-bold">Coincidencia de Búsqueda</span>
            </div>
        </div>
        <div id="searchCounter" class="hidden text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-3 py-1.5 rounded-lg border border-amber-200 dark:border-amber-800/50">
            <span id="matchingCount">0</span> ubicación(es) encontrada(s)
        </div>
    </div>

    @if (Model == null || !Model.Racks.Any())
    {
        <div class="bg-white dark:bg-[#1a2632] border border-[#dbe0e6] dark:border-gray-800 rounded-3xl p-12 text-center my-8">
            <span class="material-symbols-outlined text-gray-300 text-6xl mb-4">grid_off</span>
            <h3 class="text-[#111418] dark:text-white text-xl font-bold mb-2">No hay estantes registrados en esta bodega</h3>
            <p class="text-[#617589] dark:text-gray-400 mb-6">Crea estantes para comenzar a visualizar la cuadrícula física de almacenamiento.</p>
            @if (Model != null)
            {
                <a asp-controller="Warehouse" asp-action="Create" asp-route-warehouseId="@Model.Id" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-blue-600 transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[20px]">add</span>
                    Crear Estante
                </a>
            }
        </div>
    }
    else
    {
        <!-- Rejilla de Estantes 2D Estilo Warehouse Industrial Interactivo -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            @foreach (var rack in Model.Racks.OrderBy(r => r.Name))
            {
                var totalProductVarieties = rack.Locations.Sum(l => l.Products.Count);
                var totalUnitsInRack = rack.Locations.Sum(l => l.Products.Sum(p => p.StockQuantity));
                var occupiedRows = rack.Locations.Count(l => l.Products.Any());
                var occupancyPercentage = rack.NumberOfRows > 0 ? (occupiedRows * 100) / rack.NumberOfRows : 0;

                <div class="rack-card bg-white dark:bg-[#1a2632] border border-gray-200/80 dark:border-gray-800 rounded-3xl p-5 shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col relative overflow-hidden group hover:-translate-y-1" data-rack-id="@rack.Id" data-rack-name="@rack.Name">
                    <!-- Barra decorativa superior de estante industrial -->
                    <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-blue-500 via-indigo-500 to-emerald-500"></div>

                    <!-- Cabecera del Estante -->
                    <div class="flex justify-between items-center mb-4 pt-1 pb-3 border-b border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center font-black text-xl shadow-lg shadow-blue-500/25 shrink-0">
                                @rack.Name
                            </div>
                            <div>
                                <h3 class="text-[#111418] dark:text-white font-extrabold text-base leading-tight">Estante @rack.Name</h3>
                                <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                    <span class="text-xs text-[#617589] dark:text-gray-400 font-medium">@rack.NumberOfRows Filas</span>
                                    <span class="text-gray-300 dark:text-gray-600">•</span>
                                    <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800/40">
                                        📦 @totalUnitsInRack u. en stock
                                    </span>
                                </div>
                            </div>
                        </div>
                        <a asp-controller="Warehouse" asp-action="Edit" asp-route-id="@rack.Id" class="text-gray-400 hover:text-primary transition-colors p-2 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800" title="Configurar Estante">
                            <span class="material-symbols-outlined text-[20px]">settings</span>
                        </a>
                    </div>

                    <!-- Indicador de Ocupación del Estante -->
                    <div class="mb-4 bg-slate-50 dark:bg-slate-900/50 p-3 rounded-2xl border border-slate-100 dark:border-slate-800/80">
                        <div class="flex justify-between items-center text-xs font-bold mb-1.5">
                            <span class="text-gray-500 dark:text-gray-400">Estado de Capacidad:</span>
                            <span class="px-2 py-0.5 rounded-md text-[11px] font-black @(occupancyPercentage > 80 ? "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300" : occupancyPercentage > 0 ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300" : "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400")">
                                @occupiedRows / @rack.NumberOfRows Filas Ocupadas (@occupancyPercentage%)
                            </span>
                        </div>
                        <div class="w-full bg-gray-200 dark:bg-gray-700 h-2.5 rounded-full overflow-hidden p-0.5">
                            <div class="h-full rounded-full transition-all duration-700 @(occupancyPercentage > 80 ? "bg-gradient-to-r from-amber-400 to-amber-500" : "bg-gradient-to-r from-emerald-400 to-emerald-500")" style="width: @occupancyPercentage%"></div>
                        </div>
                    </div>

                    <!-- Estructura de Repisa / Niveles Físicos (De Arriba hacia Abajo) -->
                    <div class="flex flex-col gap-3 flex-1 bg-slate-100/90 dark:bg-slate-900/70 p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-inner">
                        @for (int r = rack.NumberOfRows; r >= 1; r--)
                        {
                            var currentRowNum = r;
                            var location = rack.Locations.FirstOrDefault(l => l.Row == currentRowNum);
                            var products = location?.Products.ToList() ?? new List<SistemaInventario.Models.Entities.Product>();
                            var hasProducts = products.Any();
                            var locationCode = $"{rack.Name}-F{currentRowNum}";
                            var totalLocationUnits = products.Sum(p => p.StockQuantity);
                            var productsSearchData = string.Join(" | ", products.Select(p => $"{p.Name} {p.Barcode} {p.Brand} {p.Description}"));

                            <div class="location-cell relative group rounded-2xl p-3.5 transition-all duration-300 border-2 cursor-pointer flex flex-col gap-2 shadow-xs hover:scale-[1.02] @(hasProducts ? "bg-white dark:bg-[#1f2d3d] border-emerald-400/80 dark:border-emerald-700/80 hover:border-emerald-500 hover:shadow-lg" : "bg-white/50 dark:bg-gray-800/30 border-dashed border-gray-300 dark:border-gray-700/70 opacity-60 hover:opacity-100 hover:border-gray-400")"
                                 data-location-code="@locationCode"
                                 data-search-text="@productsSearchData.ToLower()"
                                 onclick="openLocationDetails('@locationCode', '@rack.Name', @currentRowNum, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(products.Select(p => new {
                                     id = p.Id,
                                     name = p.Name,
                                     barcode = p.Barcode,
                                     brand = p.Brand,
                                     stock = p.StockQuantity,
                                     price = p.Price.ToString("C"),
                                     imageUrl = p.ImageUrl
                                 }))))">
                                
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-xl @(hasProducts ? "bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" : "bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-700") font-black text-xs flex items-center justify-center shrink-0 shadow-xs">
                                            F@(currentRowNum)
                                        </div>
                                        <span class="text-xs font-extrabold text-[#111418] dark:text-white group-hover:text-primary transition-colors">
                                            @locationCode
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-2 shrink-0">
                                        @if (hasProducts)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-emerald-500 text-white font-black text-xs shadow-xs">
                                                <span class="material-symbols-outlined text-[15px]">inventory_2</span>
                                                <span>@totalLocationUnits u.</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-[11px] font-semibold text-gray-400 dark:text-gray-500 px-2.5 py-1 rounded-lg bg-gray-100 dark:bg-gray-800">Disponible</span>
                                        }
                                        <span class="material-symbols-outlined text-gray-300 dark:text-gray-600 group-hover:text-primary group-hover:translate-x-1 transition-all text-[18px]">chevron_right</span>
                                    </div>
                                </div>

                                <!-- Resumen Visual de Repuestos Almacenados en esta Fila -->
                                @if (hasProducts)
                                {
                                    <div class="flex items-center gap-1.5 flex-wrap pt-1 border-t border-gray-100 dark:border-gray-700/50">
                                        @foreach (var p in products.Take(3))
                                        {
                                            var icon = p.Name.ToLower().Contains("tornillo") ? "build" : p.Name.ToLower().Contains("filtro") ? "filter_alt" : p.Name.ToLower().Contains("aceite") ? "oil_barrel" : "settings";
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 max-w-[140px] truncate" title="@p.Name (@p.StockQuantity u.)">
                                                <span class="material-symbols-outlined text-[12px] text-primary">@icon</span>
                                                <span class="truncate">@p.Name</span>
                                                <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">(@p.StockQuantity)</span>
                                            </span>
                                        }
                                        @if (products.Count > 3)
                                        {
                                            <span class="text-[10px] font-extrabold text-primary bg-blue-50 dark:bg-blue-950/50 px-1.5 py-0.5 rounded-md border border-blue-200 dark:border-blue-800/40">
                                                +@(products.Count - 3) más
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Interactivo de Detalle de Ubicación y Gestión Directa -->
<div id="locationModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-md transition-opacity opacity-0">
    <div class="w-full max-w-2xl rounded-3xl bg-white dark:bg-[#1a2632] shadow-2xl overflow-hidden transform scale-95 transition-transform border border-gray-200 dark:border-gray-800" id="locationModalContent">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-gradient-to-r from-gray-50 to-slate-100 dark:from-gray-800/50 dark:to-slate-900/50">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-primary text-white flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <span class="material-symbols-outlined text-[26px]">grid_view</span>
                </div>
                <div>
                    <h3 class="text-xl font-black text-[#111418] dark:text-white flex items-center gap-2">
                        Ubicación <span id="modalLocationCode" class="text-primary"></span>
                    </h3>
                    <p class="text-xs font-semibold text-[#617589] dark:text-gray-400" id="modalLocationSubtitle"></p>
                </div>
            </div>
            <button type="button" onclick="closeLocationModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 p-2 rounded-2xl hover:bg-gray-200/60 dark:hover:bg-gray-700 transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="p-6 max-h-[65vh] overflow-y-auto" id="modalProductsContainer">
            <!-- Productos cargados dinámicamente -->
        </div>

        <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-800 bg-gray-50/80 dark:bg-gray-800/40 flex justify-between items-center flex-wrap gap-3">
            <div class="flex items-center gap-2" id="modalProductsCount"></div>
            <button type="button" onclick="closeLocationModal()" class="px-6 py-2.5 text-sm font-bold text-gray-700 bg-white border border-[#dbe0e6] hover:bg-gray-50 rounded-xl dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 dark:hover:bg-gray-700 transition-colors cursor-pointer shadow-xs">
                Cerrar Panel
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeWarehouse(warehouseId) {
            window.location.href = `/bodegas/mapa/${warehouseId}`;
        }

        function openLocationDetails(locationCode, rackName, rowNum, products) {
            document.getElementById('modalLocationCode').innerText = locationCode;
            document.getElementById('modalLocationSubtitle').innerText = `Estante ${rackName} • Fila ${rowNum}`;
            
            const container = document.getElementById('modalProductsContainer');
            const countLabel = document.getElementById('modalProductsCount');

            if (!products || products.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <div class="w-16 h-16 rounded-3xl bg-gray-100 dark:bg-gray-800 text-gray-400 flex items-center justify-center mx-auto mb-4 border border-gray-200 dark:border-gray-700">
                            <span class="material-symbols-outlined text-3xl">inventory_2</span>
                        </div>
                        <h4 class="text-[#111418] dark:text-white font-extrabold text-lg mb-1">Ubicación Disponible / Vacía</h4>
                        <p class="text-xs text-[#617589] dark:text-gray-400 max-w-sm mx-auto">Esta fila no tiene ningún repuesto asignado actualmente. Puedes asignarla al crear o editar un producto en el sistema.</p>
                    </div>
                `;
                countLabel.innerHTML = `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 text-xs font-bold">
                        <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                        Fila sin productos
                    </span>
                `;
            } else {
                const totalUnits = products.reduce((acc, p) => acc + (p.stock || 0), 0);
                countLabel.innerHTML = `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-primary dark:text-blue-300 text-xs font-extrabold border border-blue-200 dark:border-blue-800/40">
                        <span class="material-symbols-outlined text-[16px]">category</span>
                        ${products.length} Variedad(es)
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 text-xs font-extrabold border border-emerald-200 dark:border-emerald-800/40">
                        <span class="material-symbols-outlined text-[16px]">inventory</span>
                        ${totalUnits} Unidades Totales
                    </span>
                `;
                
                container.innerHTML = `
                    <div class="flex flex-col gap-3">
                        ${products.map(p => {
                            const nameLower = p.name ? p.name.toLowerCase() : '';
                            const icon = nameLower.includes('tornillo') ? 'build' : nameLower.includes('filtro') ? 'filter_alt' : nameLower.includes('aceite') ? 'oil_barrel' : nameLower.includes('batería') || nameLower.includes('bateria') ? 'battery_charging_full' : 'settings';
                            
                            return `
                                <div class="flex items-center justify-between p-4 rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 hover:border-primary dark:hover:border-primary transition-all shadow-xs hover:shadow-md group">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-gray-700 border border-slate-200 dark:border-gray-600 flex items-center justify-center overflow-hidden shrink-0 shadow-inner relative group-hover:scale-105 transition-transform">
                                            ${p.imageUrl ? `<img src="${p.imageUrl}" class="w-full h-full object-cover" />` : `<span class="material-symbols-outlined text-primary text-2xl"> ${icon} </span>`}
                                        </div>
                                        <div class="flex flex-col gap-1">
                                            <div class="flex items-center gap-2">
                                                <h4 class="text-sm font-extrabold text-[#111418] dark:text-white leading-snug group-hover:text-primary transition-colors">${p.name}</h4>
                                            </div>
                                            <div class="flex items-center gap-2 flex-wrap">
                                                ${p.barcode ? `<span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded-md bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-600">🏷️ ${p.barcode}</span>` : ''}
                                                ${p.brand ? `<span class="text-[11px] font-semibold text-gray-500 dark:text-gray-400">Marca: <b>${p.brand}</b></span>` : ''}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-5 shrink-0">
                                        <div class="flex flex-col items-end">
                                            <span class="text-xs font-black text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 rounded-xl border border-emerald-200 dark:border-emerald-800/60 shadow-xs">
                                                📦 ${p.stock} u.
                                            </span>
                                            <span class="text-xs font-extrabold text-gray-600 dark:text-gray-300 mt-1">${p.price}</span>
                                        </div>
                                        <a href="/Products/Edit/${p.id}" target="_blank" class="p-2.5 rounded-xl bg-gray-100 dark:bg-gray-700 text-gray-500 hover:text-white hover:bg-primary transition-all shadow-xs" title="Editar Producto">
                                            <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                                        </a>
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                `;
            }

            const modal = document.getElementById('locationModal');
            const content = document.getElementById('locationModalContent');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
            }, 10);
        }

        function closeLocationModal() {
            const modal = document.getElementById('locationModal');
            const content = document.getElementById('locationModalContent');
            modal.classList.add('opacity-0');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 300);
        }

        function filterMapProducts() {
            const term = document.getElementById('mapSearchInput').value.trim().toLowerCase();
            const cells = document.querySelectorAll('.location-cell');
            const clearBtn = document.getElementById('clearSearchBtn');
            const counterBox = document.getElementById('searchCounter');
            const matchingCount = document.getElementById('matchingCount');

            if (term.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
                counterBox.classList.add('hidden');
            }

            let matchCount = 0;

            cells.forEach(cell => {
                const searchText = cell.getAttribute('data-search-text') || '';
                const locationCode = cell.getAttribute('data-location-code').toLowerCase();

                if (term.length > 0 && (searchText.includes(term) || locationCode.includes(term))) {
                    cell.classList.add('ring-4', 'ring-amber-400', 'bg-amber-100', 'dark:bg-amber-950/60', 'border-amber-400', 'animate-pulse');
                    cell.classList.remove('opacity-60');
                    matchCount++;
                } else {
                    cell.classList.remove('ring-4', 'ring-amber-400', 'bg-amber-100', 'dark:bg-amber-950/60', 'border-amber-400', 'animate-pulse');
                }
            });

            if (term.length > 0) {
                matchingCount.innerText = matchCount;
                counterBox.classList.remove('hidden');
            }
        }

        function clearMapSearch() {
            document.getElementById('mapSearchInput').value = '';
            filterMapProducts();
        }
    </script>
}
